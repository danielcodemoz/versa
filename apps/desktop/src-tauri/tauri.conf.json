{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Versa",
  "version": "0.1.0",
  "identifier": "dev.danielpro.versa",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Versa",
        "url": "desktop.html?desktop=main",
        "width": 690,
        "height": 720,
        "minWidth": 390,
        "minHeight": 480,
        "visible": false,
        "dragDropEnabled": true
      },
      {
        "label": "gesture",
        "title": "Versa",
        "url": "desktop.html?desktop=gesture",
        "width": 510,
        "height": 550,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        "versa"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "languages": ["Portuguese", "English"],
        "installerHooks": "installer/branding.nsh"
      }
    }
  }
}
