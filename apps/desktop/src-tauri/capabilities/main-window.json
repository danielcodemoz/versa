{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "versa-main-window",
  "description": "Title bar controls for the Versa main window",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
